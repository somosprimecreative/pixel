# Crie esta variável no painel da Vercel para habilitar a geração de roteiros com Claude.
# Em projetos Vercel com OIDC habilitado, este valor pode não ser necessário em produção.
AI_GATEWAY_API_KEY=

# Reutilize exatamente o mesmo projeto Supabase do Órbita. Nunca crie um
# projeto/tabelas paralelos para o Pixel. Os valores devem ficar apenas no
# ambiente local ou na Vercel, nunca neste arquivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive (opcional). Todos estes valores ficam apenas no ambiente do
# servidor/Vercel. Nunca use NEXT_PUBLIC_ para qualquer segredo do Drive.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
# Base64 de 32 bytes aleatórios, exclusiva para criptografar refresh tokens.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
# Identificador da chave atual. Altere ao rotacionar a chave e reconecte as contas.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY_VERSION=v1
# Segredo aleatório com pelo menos 32 caracteres para assinar o state OAuth.
GOOGLE_DRIVE_OAUTH_STATE_SECRET=
